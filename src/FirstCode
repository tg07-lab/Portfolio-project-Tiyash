import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;


 // @author Tiyash Ghosh

public class WorkoutSession {

    /**
     * Internal class to store a single set entry (reps + load).
     */
    private static class SetEntry {
        int reps;
        int load;

        SetEntry(int reps, int load) {
            this.reps = reps;
            this.load = load;
        }

        @Override
        public String toString() {
            return reps + " reps @ " + load + " lbs";
        }
    }

    /**
     * Internal representation: maps exercise name to a list of SetEntry objects.
     */
    private Map<String, List<SetEntry>> session;

    /**
     * Constructor: creates an empty WorkoutSession.
     */
    public WorkoutSession() {
        this.session = new HashMap<>();
    }

    // KERNEL METHODS

    public void addSet(String exercise, int reps, int load) {
        if (!this.session.containsKey(exercise)) {
            this.session.put(exercise, new ArrayList<>());
        }
        this.session.get(exercise).add(new SetEntry(reps, load));
    }

    public boolean removeLastSet(String exercise) {
        if (!this.session.containsKey(exercise)) {
            return false;
        }
        List<SetEntry> sets = this.session.get(exercise);
        if (sets.isEmpty()) {
            return false;
        }
        sets.remove(sets.size() - 1);
        if (sets.isEmpty()) {
            this.session.remove(exercise);
        }
        return true;
    }

    public boolean hasExercise(String exercise) {
        return this.session.containsKey(exercise) &&
               !this.session.get(exercise).isEmpty();
    }
    public void clear() {
        this.session.clear();
    }

    // SECONDARY METHODS

    public int totalVolume(String exercise) {
        if (!this.hasExercise(exercise)) {
            return 0;
        }
        int volume = 0;
        for (SetEntry s : this.session.get(exercise)) {
            volume += s.reps * s.load;
        }
        return volume;
    }

    public int totalSets(String exercise) {
        if (!this.hasExercise(exercise)) {
            return 0;
        }
        return this.session.get(exercise).size();
    }

    public int bestSetLoad(String exercise) {
        if (!this.hasExercise(exercise)) {
            return 0;
        }
        int best = 0;
        for (SetEntry s : this.session.get(exercise)) {
            if (s.load > best) {
                best = s.load;
            }
        }
        return best;
    }

    public double averageLoad(String exercise) {
        if (!this.hasExercise(exercise)) {
            return 0.0;
        }
        List<SetEntry> sets = this.session.get(exercise);
        int total = 0;
        for (SetEntry s : sets) {
            total += s.load;
        }
        return (double) total / sets.size();
    }

    public boolean progressedFrom(String exercise, WorkoutSession previous) {
        return this.totalVolume(exercise) > previous.totalVolume(exercise);
    }

    @Override
    public String toString() {
        if (this.session.isEmpty()) {
            return "WorkoutSession: (empty)";
        }
        StringBuilder sb = new StringBuilder("WorkoutSession:\n");
        for (Map.Entry<String, List<SetEntry>> entry : this.session.entrySet()) {
            sb.append("  ").append(entry.getKey()).append(":\n");
            int setNum = 1;
            for (SetEntry s : entry.getValue()) {
                sb.append("    Set ").append(setNum++).append(": ").append(s).append("\n");
            }
        }
        return sb.toString();
    }

    // MAIN METHOD


    public static void main(String[] args) {

        System.out.println("=== Workout Session Proof of Concept ===\n");

        // --- Session 1: Last week's workout ---
        WorkoutSession lastWeek = new WorkoutSession();

        lastWeek.addSet("Squat", 5, 185);
        lastWeek.addSet("Squat", 5, 185);
        lastWeek.addSet("Squat", 5, 185);

        lastWeek.addSet("Bench Press", 8, 135);
        lastWeek.addSet("Bench Press", 8, 135);
        lastWeek.addSet("Bench Press", 6, 135);

        lastWeek.addSet("Deadlift", 5, 225);
        lastWeek.addSet("Deadlift", 3, 245);

        System.out.println("Last week's session:");
        System.out.println(lastWeek);

        // --- Session 2: This week's workout ---
        WorkoutSession thisWeek = new WorkoutSession();

        thisWeek.addSet("Squat", 5, 195);
        thisWeek.addSet("Squat", 5, 195);
        thisWeek.addSet("Squat", 5, 195);

        thisWeek.addSet("Bench Press", 8, 140);
        thisWeek.addSet("Bench Press", 8, 140);
        thisWeek.addSet("Bench Press", 7, 140);

        // Accidentally logged a bad set — remove it and re-log
        thisWeek.addSet("Deadlift", 5, 200); // wrong weight logged
        thisWeek.removeLastSet("Deadlift");
        thisWeek.addSet("Deadlift", 5, 255);
        thisWeek.addSet("Deadlift", 3, 265);

        System.out.println("This week's session:");
        System.out.println(thisWeek);

        System.out.println("--- Kernel Method Demos ---");
        System.out.println("Has 'Squat'? " + thisWeek.hasExercise("Squat"));
        System.out.println("Has 'Pull-up'? " + thisWeek.hasExercise("Pull-up"));
        System.out.println();

        System.out.println("--- Secondary Method Demos ---");

        System.out.println("Squat:");
        System.out.println("  Total sets:    " + thisWeek.totalSets("Squat"));
        System.out.println("  Total volume:  " + thisWeek.totalVolume("Squat") + " lbs");
        System.out.println("  Best set load: " + thisWeek.bestSetLoad("Squat") + " lbs");
        System.out.println("  Average load:  " + thisWeek.averageLoad("Squat") + " lbs");
        System.out.println();

        System.out.println("Bench Press:");
        System.out.println("  Total sets:    " + thisWeek.totalSets("Bench Press"));
        System.out.println("  Total volume:  " + thisWeek.totalVolume("Bench Press") + " lbs");
        System.out.println("  Best set load: " + thisWeek.bestSetLoad("Bench Press") + " lbs");
        System.out.println("  Average load:  " + thisWeek.averageLoad("Bench Press") + " lbs");
        System.out.println();

        System.out.println("Deadlift:");
        System.out.println("  Total sets:    " + thisWeek.totalSets("Deadlift"));
        System.out.println("  Total volume:  " + thisWeek.totalVolume("Deadlift") + " lbs");
        System.out.println("  Best set load: " + thisWeek.bestSetLoad("Deadlift") + " lbs");
        System.out.println("  Average load:  " + thisWeek.averageLoad("Deadlift") + " lbs");
        System.out.println();

        System.out.println("--- Progress Check (this week vs last week) ---");
        String[] lifts = { "Squat", "Bench Press", "Deadlift" };
        for (String lift : lifts) {
            boolean improved = thisWeek.progressedFrom(lift, lastWeek);
            System.out.println(lift + " improved: " + improved
                    + " (" + lastWeek.totalVolume(lift) + " -> "
                    + thisWeek.totalVolume(lift) + " lbs total volume)");
        }
        System.out.println();

        System.out.println("--- Clearing the session ---");
        thisWeek.clear();
        System.out.println("Has 'Squat' after clear? " + thisWeek.hasExercise("Squat"));
        System.out.println(thisWeek);
    }
}